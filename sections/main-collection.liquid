<section class="products-grid-section" style="--grid-columns: {{ section.settings.columns_desktop }}">
  <h1 class="products-grid-heading">{{ collection.title | escape }}</h1>
  {% if collection.description != blank %}
    <div class="rte">{{ collection.description }}</div>
  {% endif %}
  {% paginate collection.products by section.settings.products_to_show %}
    {% if collection.products_count == 0 %}
      <p class="grid-empty-state">This collection has no products yet.</p>
    {% else %}
      <div class="products-grid" role="list">
        {% for product in collection.products %}
          <div role="listitem">{% render 'product-card', product: product %}</div>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {% endif %}
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Collection products",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products per page",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    }
  ]
}
{% endschema %}
