<header class="site-header">
  {% if section.settings.menu != blank %}
    <nav class="site-nav" aria-label="Main navigation">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {% endfor %}
    </nav>
  {% endif %}
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
